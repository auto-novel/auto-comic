(spa) {
	root * {args[0]}

	handle /assets/* {
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match status 2xx
		}
		file_server
	}

	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}

:80 {
	encode

	redir /admin /admin/
	handle_path /admin/* {
		import spa /admin
	}

	handle {
		import spa /web
	}

	handle_path /api/* {
		reverse_proxy api:7001
	}
}
